                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource FaintBrush}" FontSize="12.5" VerticalAlignment="Center"
                                                                       ToolTip="접속한 지 지난 시간" />
                                                            <Border DockPanel.Dock="Right" Margin="0,0,12,0" Padding="7,1" CornerRadius="4" VerticalAlignment="Center"
                                                                    Background="{StaticResource AmberTintBrush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1"
                                                                    Visibility="{Binding HasFaction, Converter={StaticResource BoolToVis}}" ToolTip="고른 진영">
                                                                <TextBlock Text="{Binding Faction}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
