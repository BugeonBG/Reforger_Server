                                </Button>
                                <TextBlock Style="{StaticResource Note}" Margin="14,0,0,0"
                                           Text="공유기를 쓰면 공유기 관리 페이지에서도 같은 포트를 이 PC로 포트포워딩하세요. 서버 목록에 안 보이면 대부분 이 문제입니다." />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 서버 설정 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="36,4,36,20">
                            <TextBlock Style="{StaticResource H1}" Text="서버 설정" />
