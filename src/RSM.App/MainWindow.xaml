                                                        ToolTip="설치된 서버로 시나리오 목록을 뽑아 워크숍 시나리오까지 목록에 추가합니다. 1~2분 걸릴 수 있습니다." />
                                                <ComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedScenario}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Key}" Text="시나리오 ID" />
                                                <TextBlock Style="{StaticResource KeyHint}" Text="목록에 없으면 붙여넣기" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Text="{Binding ScenarioId, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="최대 인원" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Width="110" Text="{Binding MaxPlayers, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource Note}" Margin="12,0,0,0" Text="1~256명" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="접속과 관리자" />
                                    <Border Style="{StaticResource Rows}">
                                        <StackPanel>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Key}" Text="접속 비밀번호" />
                                                    <TextBox Grid.Column="1" Tag="비우면 누구나 접속" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Key}" Text="관리자 비밀번호" />
                                                    <TextBox Grid.Column="1" Tag="채팅에서 #login 비밀번호" Text="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="게임 채팅에서 #login 비밀번호 로 관리자가 됩니다. 공백 없이 입력하세요." />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Key}" Text="관리자 SteamID" Margin="0,8,0,0" />
                                                        <TextBlock Style="{StaticResource KeyHint}" Text="한 줄에 하나" />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Style="{StaticResource MultiBox}" Height="72" Tag="76561198…"
                                                             Text="{Binding AdminsText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="SteamID64(17자리 숫자) 또는 IdentityId. 여기 있는 사람은 비밀번호 없이 관리자가 됩니다." />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="게임 규칙" />
                                    <Border Style="{StaticResource Rows}">
                                        <StackPanel>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" Content="서버 목록에 표시" IsChecked="{Binding Visible}" />
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" Content="콘솔(Xbox 등) 크로스플레이" IsChecked="{Binding CrossPlatform}" />
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" Content="3인칭 끄기" IsChecked="{Binding DisableThirdPerson}" />
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" Content="BattlEye 안티치트" IsChecked="{Binding BattlEye}" />
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" Content="다른 진영에 무전 송신 허용" IsChecked="{Binding VonCanTransmitCrossFaction}" />
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding FastValidation}"
                                                          ToolTip="접속할 때 모드 파일 검사를 빠르게 합니다. 보통 켜 둡니다.">
                                                    <TextBlock><Run Text="빠른 파일 검증" /><Run Text="  fastValidation" Foreground="{StaticResource FaintBrush}" FontSize="12" /></TextBlock>
                                                </CheckBox>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="네트워크" />
