<Window x:Class="RSM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RSM.App"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1440" Height="900" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- our own title bar: the dark theme reaches the top edge -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:HistoryGeometryConverter x:Key="HistoryGeo" />
        <local:LogLineBrushConverter x:Key="LogBrush" />

        <!-- log explanation: coloured badge by severity (good / info / harmless / caution / problem) -->
        <Style x:Key="SeverityBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#228FA3B8" />
            <Setter Property="TextElement.Foreground" Value="#9FB2C6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="good">
                    <Setter Property="Background" Value="#229DD06F" />
                    <Setter Property="TextElement.Foreground" Value="#9DD06F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="harmless">
                    <Setter Property="Background" Value="#228A8D80" />
                    <Setter Property="TextElement.Foreground" Value="#A3A698" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="caution">
                    <Setter Property="Background" Value="#22E3B04F" />
                    <Setter Property="TextElement.Foreground" Value="#E3B04F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="problem">
                    <Setter Property="Background" Value="#26EE7B63" />
                    <Setter Property="TextElement.Foreground" Value="#EE7B63" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one explanation: badge, title, meaning, what to do, where it came from -->
        <DataTemplate x:Key="ExplanationTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SeverityBadge}">
                        <TextBlock Text="{Binding SeverityText}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextBrush}" Text="{Binding Meaning}" />
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource AmberTintBrush}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="할 일" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AmberBrush}" />
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="20" Text="{Binding Action}" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap">
                    <Run Text="출처: " /><Run Text="{Binding Module, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveConfigCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="#3A4033" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <!-- a maximized custom-chrome window hangs 7px past the screen edge -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--=================================================================== sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SideBrush}" BorderBrush="#2A2F25" BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- brand (part of the draggable title area) -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="44" Margin="18,0,0,0">
                        <Image Source="pack://application:,,,/Assets/logo-64.png" Width="20" Height="20" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="리포저 서버 관리자" Margin="10,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <!-- server state: the one thing you look at first -->
                    <Border DockPanel.Dock="Top" Margin="14,6,14,18" Padding="16,16,16,14" CornerRadius="10"
                            Background="{StaticResource StateCardBrush}" BorderBrush="{StaticResource StateCardLineBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Ellipse Width="22" Height="22">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource RunHaloBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse Width="12" Height="12">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource OffBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource RunBrush}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource RunColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.8" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Margin="8,0,0,0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="꺼짐" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Text" Value="실행 중" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Grid Margin="0,6,0,14">
                                <TextBlock Text="설정을 저장하고 서버를 켭니다" FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="게임" />
                                        <Run Text="UDP" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run
                                             Text=" " /><Run Text="{Binding BindPort, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    </TextBlock>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedScenario.DisplayName, FallbackValue='사용자 지정 시나리오'}" />
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding StartServerCommand}" ToolTip="설정을 저장한 뒤 서버를 켭니다.">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BigStart}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="서버 시작" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopServerCommand}" Style="{StaticResource BigStop}"
                                    Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="서버 중지" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- save + version, pinned to the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,12">
                        <Button Command="{Binding SaveConfigCommand}" ToolTip="config.json에 저장합니다 (Ctrl+S)" HorizontalAlignment="Stretch" MinHeight="36">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                            <Setter Property="Background" Value="{StaticResource AmberTintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="모두 저장됨" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Text" Value="● 변경 사항 저장" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Line2Brush}" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+S" FontSize="11" Foreground="{StaticResource FaintBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- version; becomes an update button when GitHub has a newer RSM -->
                        <TextBlock Text="{Binding AppVersionText}" Margin="4,10,0,0" FontSize="12" Foreground="{StaticResource FaintBrush}" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{StaticResource Primary}" MinHeight="32" FontSize="12.5"
                                Content="{Binding AppUpdateButtonText}" Command="{Binding InstallAppUpdateCommand}"
                                Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="새 RSM을 받아서 바꾼 뒤 다시 켭니다. 설정과 모드는 그대로입니다." />
                    </StackPanel>

                    <!-- navigation -->
                    <StackPanel Margin="10,0">
                        <RadioButton x:Name="NavInstall" Style="{StaticResource NavItem}" Tag="&#xE896;" Content="서버 설치" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE9E9;" Content="서버 설정" IsChecked="True" />
                        <RadioButton x:Name="NavMonitor" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="서버 현황" />
                        <RadioButton x:Name="NavMods" Style="{StaticResource NavItem}" Tag="&#xE8F1;">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,1" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModsBadgeText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <TextBlock Text="모드" VerticalAlignment="Center" />
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavBrowse" Style="{StaticResource NavItem}" Tag="&#xE774;" Content="워크숍" Checked="OnBrowseOpened" />
                        <RadioButton x:Name="NavFile" Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="설정 파일" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--=================================================================== main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition x:Name="PageRow" Height="*" MinHeight="200" />
                    <RowDefinition x:Name="SplitterRow" Height="8" />
                    <RowDefinition x:Name="ConsoleRow" Height="300" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- caption buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="최소화" />
                    <Button Click="OnMaximize">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Caption}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="ToolTip" Value="최대화" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="ToolTip" Value="이전 크기로" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="닫기" />
                </StackPanel>

                <!--============================================ pages -->
                <Grid Grid.Row="1">

                    <!-- 서버 설치 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=NavInstall, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="36,4,36,20">
                            <TextBlock Style="{StaticResource H1}" Text="서버 설치" />
                            <TextBlock Style="{StaticResource Lede}" Text="SteamCMD로 서버 파일을 내려받고, 게임이 업데이트되면 여기서 서버도 같이 올립니다." />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="설치 위치" />
                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Key}" Text="SteamCMD 폴더" />
                                                <TextBlock Style="{StaticResource KeyHint}" Text="없으면 자동으로 받습니다" />
                                            </StackPanel>
                                            <DockPanel Grid.Column="1">
                                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="찾아보기" Command="{Binding BrowseSteamCmdDirCommand}" />
                                                <TextBox Text="{Binding SteamCmdDir, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="서버 폴더" />
                                            <DockPanel Grid.Column="1">
                                                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Style="{StaticResource Ghost}" Content="열기" Command="{Binding OpenServerDirCommand}" />
                                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="찾아보기" Command="{Binding BrowseServerDirCommand}" />
                                                <TextBox Text="{Binding ServerDir, UpdateSourceTrigger=LostFocus}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="실험 버전" />
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding UseExperimental}">
                                                <TextBlock Text="실험(Experimental) 버전 게임으로만 접속할 수 있습니다" Foreground="{StaticResource MutedBrush}" />
                                            </CheckBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                <Button Style="{StaticResource Primary}" Command="{Binding InstallOrUpdateCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding InstallButtonText}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="● 아직 설치되지 않음" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServerInstalled}" Value="True">
                                                    <Setter Property="Text" Value="● 설치됨" />
                                                    <Setter Property="Foreground" Value="{StaticResource RunBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="14,0,0,0" Style="{StaticResource Note}" Text="서버를 멈춰야 업데이트할 수 있습니다"
                                           Visibility="{Binding IsServerRunning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="업데이트" />
                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="서버 버전" />
                                            <DockPanel Grid.Column="1">
                                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="지금 확인" Command="{Binding CheckUpdateCommand}"
                                                        ToolTip="스팀에 새 서버 버전이 나왔는지 확인합니다. 새 버전이면 업데이트할지 묻습니다." />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding BuildStatusText}" />
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCheckingUpdate}" Value="True">
                                                                    <Setter Property="Text" Value="스팀에서 최신 버전 확인 중…" />
                                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="자동 업데이트" />
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdateOnLaunch}">
                                                <TextBlock Text="프로그램을 켤 때마다 새 버전을 확인하고, 있으면 자동으로 업데이트합니다" Foreground="{StaticResource MutedBrush}" />
                                            </CheckBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="RSM 업데이트" />
                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="이 프로그램" />
                                            <DockPanel Grid.Column="1">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Margin="8,0,0,0" Content="지금 확인" Command="{Binding CheckAppUpdateCommand}"
                                                            ToolTip="GitHub에 새 RSM이 올라왔는지 확인합니다. 있으면 설치할지 묻습니다." />
                                                    <Button Margin="8,0,0,0" Style="{StaticResource Ghost}" Content="릴리스 페이지" Command="{Binding OpenReleasesCommand}" />
                                                </StackPanel>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding AppUpdateStatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AppUpdateAvailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="자동 확인" />
                                            <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoUpdateApp}">
                                                <TextBlock Text="프로그램을 켤 때 새 RSM이 있는지 확인하고, 있으면 설치할지 묻습니다" Foreground="{StaticResource MutedBrush}" />
                                            </CheckBox>
                                        </Grid>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Row}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBakedRepository}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="GitHub 저장소" ToolTip="build.bat으로 직접 만든 RSM.exe에만 필요합니다. GitHub 릴리스에서 받은 RSM.exe에는 이미 들어 있습니다." />
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Tag="아이디/RSM 또는 github.com 링크"
                                                     Text="{Binding UpdateRepository, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="열어야 할 포트" />
                                <TextBlock Style="{StaticResource Note}" Margin="10,0,0,0" Text="모두 UDP" />
                            </StackPanel>
                            <UniformGrid Columns="3">
                                <Border Margin="0,0,10,0" Padding="14,12" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
