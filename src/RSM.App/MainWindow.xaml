                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="서버 이름" />
                                            <TextBox Grid.Column="1" MaxLength="100" Tag="서버 목록에 보일 이름"
                                                     Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="시나리오" />
