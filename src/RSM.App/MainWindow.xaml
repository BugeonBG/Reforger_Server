                                        <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="RCON (꺼짐)" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RconEnabled}" Value="True">
                                                            <Setter Property="Text" Value="RCON" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
