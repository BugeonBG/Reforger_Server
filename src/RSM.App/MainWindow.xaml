                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Path Stretch="Fill" Fill="#2286C56F"
                                                  Data="{Binding PlayerHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=area}" />
                                            <Path Stretch="Fill" Stroke="{StaticResource RunBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  Data="{Binding PlayerHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=line}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Margin="0,0,12,12" Padding="18,16" CornerRadius="10" Background="{StaticResource StateCardBrush}"
                                        BorderBrush="{StaticResource StateCardLineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="46" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="CPU (서버)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="{Binding ServerCpuText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Margin="0,2,0,0" FontSize="12.5" Foreground="{StaticResource FaintBrush}" Text="{Binding SystemCpuText}" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Path Stretch="Fill" Fill="#22E3A33B"
                                                  Data="{Binding CpuHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=area}" />
                                            <Path Stretch="Fill" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  Data="{Binding CpuHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=line}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Margin="0,0,12,12" Padding="18,16" CornerRadius="10" Background="{StaticResource StateCardBrush}"
                                        BorderBrush="{StaticResource StateCardLineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="46" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="메모리 (서버)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="{Binding ServerRamText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Margin="0,2,0,0" FontSize="12.5" Foreground="{StaticResource FaintBrush}" Text="{Binding SystemRamText}" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Path Stretch="Fill" Fill="#22E3A33B"
                                                  Data="{Binding RamHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=area}" />
                                            <Path Stretch="Fill" Stroke="{StaticResource AmberBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  Data="{Binding RamHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=line}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Margin="0,0,12,12" Padding="18,16" CornerRadius="10" Background="{StaticResource StateCardBrush}"
                                        BorderBrush="{StaticResource StateCardLineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="46" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE839;" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="네트워크 (이 PC 전체)" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="{Binding NetDownText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Margin="0,2,0,0" FontSize="12.5" Foreground="{StaticResource FaintBrush}" Text="{Binding NetUpText}" TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Path Stretch="Fill" Fill="#229EC3C9"
                                                  Data="{Binding NetHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=area}" />
                                            <Path Stretch="Fill" Stroke="#9EC3C9" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  Data="{Binding NetHistory, Converter={StaticResource HistoryGeo}, ConverterParameter=line}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </UniformGrid>

