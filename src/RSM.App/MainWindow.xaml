                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="게임 포트" />
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Text="{Binding BindPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Key}" Text="A2S 포트" ToolTip="스팀 서버 목록이 서버 정보를 묻는 포트" />
                                            <TextBox Grid.Column="4" Width="140" HorizontalAlignment="Left" Style="{StaticResource MonoBox}" Text="{Binding A2sPort, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Key}" Text="공개 포트" />
                                                <TextBlock Style="{StaticResource KeyHint}" Text="보통 게임 포트와 같게" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Text="{Binding PublicPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Key}" Text="공개 IP" />
                                            <TextBox Grid.Column="4" Style="{StaticResource MonoBox}" Tag="비우면 자동으로 찾습니다"
                                                     Text="{Binding PublicAddress, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="원격 관리 (RCON)" />
                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding RconEnabled}">
                                            <TextBlock><Run Text="RCON 켜기" /><Run Text="  BattleMetrics 같은 도구로 밖에서 서버를 관리합니다" Foreground="{StaticResource FaintBrush}" FontSize="12.5" /></TextBlock>
                                        </CheckBox>
                                    </Border>
                                    <Border Style="{StaticResource Row}" IsEnabled="{Binding RconEnabled}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Key}" Text="RCON 포트" />
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Text="{Binding RconPort, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Key}" Text="비밀번호 / 권한" />
                                            <DockPanel Grid.Column="4">
                                                <ComboBox DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" ItemsSource="{Binding RconPermissions}" SelectedItem="{Binding RconPermission}"
                                                          ToolTip="admin: 모든 명령 / monitor: 보기만" />
                                                <TextBox Tag="공백 없이" Text="{Binding RconPassword, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="시야 거리" />
                            <Border Style="{StaticResource Rows}">
                                <StackPanel>
                                    <Border Style="{StaticResource Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Key}" Text="최대 시야" />
                                                <TextBlock Style="{StaticResource KeyHint}" Text="500~10000 m" />
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Style="{StaticResource MonoBox}" Text="{Binding ServerMaxViewDistance, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Key}" Text="네트워크 시야" />
                                                <TextBlock Style="{StaticResource KeyHint}" Text="500~5000 m" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <TextBox Width="140" Style="{StaticResource MonoBox}" Text="{Binding NetworkViewDistance, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource Note}" Margin="12,0,0,0" Text="높을수록 서버 부하가 커집니다" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 서버 현황 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=NavMonitor, Converter={StaticResource BoolToVis}}"
                                  DataContext="{Binding Monitor}">
                        <StackPanel Margin="36,4,24,20">
                            <TextBlock Style="{StaticResource H1}" Text="서버 현황" />
                            <TextBlock Style="{StaticResource Lede}" Margin="0,0,12,18"
                                       Text="2초마다 새로 고칩니다. 그래프는 최근 5분입니다. CPU·메모리 큰 숫자는 서버 프로그램 기준이고, 네트워크는 이 PC 전체 기준입니다." />

                            <UniformGrid Columns="2">
                                <Border Margin="0,0,12,12" Padding="18,16" CornerRadius="10" Background="{StaticResource StateCardBrush}"
                                        BorderBrush="{StaticResource StateCardLineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="46" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE716;" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
