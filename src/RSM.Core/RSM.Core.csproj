<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not drawing a window lives here, so it builds and is tested on any OS. -->
  <PropertyGroup>
    <!-- the exe/dll "Details" tab shows these -->
    <Authors>Anu</Authors>
    <Company>Anu</Company>
    <Product>RSM (Reforger Server Manager)</Product>
    <Copyright>Copyright © 2026 Anu. All rights reserved.</Copyright>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RSM.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
